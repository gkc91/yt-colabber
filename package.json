{
  "name": "clickable",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter mobile start",
    "dev:mobile:local": "node scripts/dev-mobile-local.mjs",
    "dev:landing": "pnpm --filter landing dev",
    "db:reset": "supabase db reset && node scripts/local-storage-index.mjs",
    "db:types": "supabase gen types typescript --local --schema public > apps/mobile/src/lib/database.types.ts",
    "test:db": "supabase test db",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build:landing": "pnpm --filter landing build",
    "check:landing": "pnpm --filter landing build && node scripts/check-landing.mjs",
    "build:web": "pnpm --filter mobile build:web",
    "check:web": "pnpm --filter mobile build:web && node scripts/check-web-export.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.117.0"
  }
}
